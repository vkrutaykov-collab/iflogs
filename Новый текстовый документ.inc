	format(s_Global, sizeof s_Global, "[Admin] Администратор %s[%d] выдал кейсы %s всем в количестве %d шт", GetPlayerNameEx(playerid), playerid, ItemsInfo[type][i_item_name], random111);
	SendMessageToAdmins(s_Global, 0xFFFF00FF);

	return 1;
}
