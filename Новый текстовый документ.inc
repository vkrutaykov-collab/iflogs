public: Cases_OnPlayerSprayItem(playerid)
{
    if(GetPVarInt(playerid, "type_priz") != 0)
    {
        new items = GetPVarInt(playerid, "type_priz") - 1;
        new case_index = GetPVarInt(playerid, "case_type");
        new type = GetCaseIndex(case_index);
        CEF_HIDE(playerid, "CaseResult");
        new prize_type = g_case_cef[type][items][E_TYPE_PRIZE];
        new token_count = GetCaseTokenByType(prize_type);
        if(token_count > 0)
        {
            new current_tokens = GetPlayerData(playerid, P_CASE_TOKEN);
            SetPlayerData(playerid, P_CASE_TOKEN, current_tokens + token_count);
            UpdatePlayerDatabaseInt(playerid, "case_token", current_tokens + token_count);

            new fmt_msg[128];
            format(fmt_msg, sizeof fmt_msg, "Вы распылили предмет и получили %d токенов! (Всего: %d)", token_count, current_tokens + token_count);
            SCM(playerid, 0x6495EDFF, fmt_msg);
        }
        if(GetPVarInt(playerid, "CaseFree") == 1)
        {
            SetPVarInt(playerid, "CaseFree", 0);
        }
        else
        {
            if(GetIteam(playerid, GetPVarInt(playerid, "case_id")) > 0) ShowCase(playerid);
        }
        SetPVarInt(playerid, "type_priz", 0);
        if(kase_open[playerid] == 0)
        {
            DestroyDynamicObject(kase_osnova[playerid]);
            DestroyDynamicObject(kase_krishka[playerid]);
            DestroyDynamicObject(kase_prize[playerid]);
            DestroyDynamic3DTextLabel(kase_text[playerid]);
            SetCameraBehindPlayer(playerid);
        }
    }
    return 1;
}
stock GetCaseTokenByType(type_prize)
{
    switch(type_prize)
    {
        case 0: return 5;
        case 1: return 10;
        case 2: return 15;
        case 3: return 20;
    }
    return 0;
}
